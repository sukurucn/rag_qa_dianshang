# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=rag_user
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_password
MYSQL_DATABASE=rag_db
MYSQL_CHARSET=utf8mb4

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace_with_a_strong_password

# MySQL QA
MYSQL_QA_TABLE_NAME=question_answers
MYSQL_QA_REDIS_KEY=mysql_qa:questions
MYSQL_QA_THRESHOLD=0.8

# 问题改写 LLM（OpenAI 兼容接口）
REWRITE_LLM_BASE_URL=http://127.0.0.1:8000/v1
REWRITE_LLM_API_KEY=replace_with_llm_api_key
REWRITE_LLM_MODEL=gpt-4o-mini
REWRITE_LLM_TIMEOUT_SECONDS=30
REWRITE_LLM_MAX_TOKENS=512
REWRITE_MAX_ROUNDS=3
REWRITE_MAX_SUBQUESTIONS=6

# RAG 检索与回答
RAG_TOP_K=5
RAG_FINAL_PARENT_COUNT=2
RAG_CUSTOMER_SERVICE_PHONE=30129032
MILVUS_DENSE_INDEX_NLIST=128
MILVUS_DENSE_SEARCH_NPROBE=10

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=replace_with_a_strong_password
MILVUS_DATABASE=default

# MinIO (Milvus object storage)
MINIO_ACCESS_KEY=replace_with_access_key
MINIO_SECRET_KEY=replace_with_a_strong_secret

# MinerU（仅处理 PDF、PPT/PPTX 时必填）
MINERU_API_KEY=replace_with_mineru_api_key
